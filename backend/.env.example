# ─────────────────────────────────────────────────────────────────────────────
# Mzaya backend — environment template
#
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
#
# The app validates its configuration on boot (src/config/validateEnv.js) and
# REFUSES TO START if anything required is missing — deliberately. A misconfigured
# server should fail loudly at boot, not silently at 2am on the first request that
# needs the missing value.
#
# Grouping below mirrors that validator exactly:
#   [1] Required always
#   [2] Required in production
#   [3] Required in production — HARD (no fallback; refuses to boot)
#   [4] Optional
# ─────────────────────────────────────────────────────────────────────────────


# ═══ [1] REQUIRED ALWAYS ═════════════════════════════════════════════════════

# PostgreSQL connection string.
DB_URL=postgresql://postgres:your_password@localhost:5432/mzaya

# Signs auth tokens. Use at least 32 random characters. There is no fallback, and
# there must not be one. Generate a strong value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_at_least_32_random_characters


# ═══ [2] REQUIRED IN PRODUCTION ══════════════════════════════════════════════

# Comma-separated allowlist of frontend origins (CORS + sockets). Without it in
# production the server refuses to boot rather than fall through to open CORS.
#   e.g. https://mzaya.co.zw,https://www.mzaya.co.zw
CLIENT_ORIGINS=http://localhost:5173

# Public URL of THIS backend. Paynow webhooks (resulturl) resolve against it.
APP_URL=http://localhost:5000

# Public URL of the frontend. Paynow redirects the customer back here after
# payment.
CLIENT_URL=http://localhost:5173


# ═══ [3] REQUIRED IN PRODUCTION — HARD (refuses to boot without these) ════════
#
# ⚠️  AWAITING REAL CREDENTIALS. In development you can leave these blank and set
#     ALLOW_MOCK_PAYMENTS=true (below) to simulate payments. In PRODUCTION the
#     server will not start until they are real.

# --- Paynow (payment gateway) --------------------------------------------------
# Without these, payments run SIMULATED — the site would take orders and move no
# money. Get them from your Paynow merchant dashboard.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# --- Cloudinary (image hosting) ------------------------------------------------
# Without these, uploads (vendor logos, delivery-proof photos) land on the
# container's local disk, which is WIPED on every redeploy. Free tier is enough to
# start. Get them from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ═══ [4] OPTIONAL ════════════════════════════════════════════════════════════

# Node environment. 'development' locally, 'production' when deployed.
NODE_ENV=development

# Port the server listens on.
PORT=5000

# Simulated payments. Development ONLY. Lets the app run without Paynow
# credentials. The server refuses to boot with this set to true in production.
ALLOW_MOCK_PAYMENTS=true

# Redis — rate limiting (and the ML service cache). Without it, rate limits are
# per-instance and reset on each deploy. Fine for a single instance; needed once
# you scale horizontally.
#   e.g. redis://localhost:6379
REDIS_URL=

# The Python ML microservice (anomaly detection, demand forecasting, surge).
ML_SERVICE_URL=http://localhost:8000

# Force TLS on the database connection. Auto-enabled in production; set to 'true'
# to force it in other environments (some managed Postgres providers require it).
DB_SSL=

# Manual USD→ZiG rate override. If unset, the currency service uses its own
# source. Set a number to pin the displayed rate, e.g. 27.50
ZIG_RATE=

# Log verbosity: error | warn | info | debug. Defaults sensibly if unset.
LOG_LEVEL=info


# ═══ TESTS ═══════════════════════════════════════════════════════════════════

# The integration suite runs against a SEPARATE database so it can drop and
# recreate tables without touching your dev data. If unset, it derives one by
# appending _test to DB_URL. Set explicitly if your test DB differs.
#   Create it once:  createdb mzaya_test
TEST_DB_URL=postgresql://postgres:your_password@localhost:5432/mzaya_test
