# Copy to `.env` (which is gitignored).
#
# One variable drives everything: the REST client, the Socket.IO connection, and
# the image-URL helper all derive their origin from it. Deliberately one, not two
# — a second env var for the same backend is the classic way for real-time to
# silently fail in production while the rest of the app works.
#
# Must include the /api suffix.
VITE_API_URL=http://localhost:5000/api

# Optional: ZiG rate for showing catalogue prices in both currencies.
# Orders already carry their own total_zig from the backend; this is only for
# browse/cart prices. Leave blank to hide ZiG on catalogue items.
VITE_ZIG_RATE=
